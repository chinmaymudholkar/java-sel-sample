<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Swag Labs Test Suite" verbose="1" parallel="methods" thread-count="5">
    <listeners>
        <listener class-name="io.github.chinmaymudholkar.listeners.TestListener"/>
    </listeners>
    
    <test name="Login Tests" preserve-order="true">
        <classes>
            <class name="io.github.chinmaymudholkar.tests.LoginTest"/>
        </classes>
    </test>
    
</suite>
